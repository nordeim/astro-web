---
// Submenu definitions — kept inline here (not in a content collection) because
// the menu structure is presentation, not editorial content. Links point at
// existing routes/anchors; verify with `npm run check:links` after any change.
const navItems = [
  {
    label: 'Services',
    href: '/services/',
    hasDropdown: true,
    submenu: [
      { label: 'Branding & Design', href: '/services/#branding-design' },
      { label: 'Websites', href: '/services/#websites' },
      { label: 'Marketing & Strategy', href: '/services/#marketing-strategy' },
      { label: 'Video & Photo', href: '/services/#media' },
      { label: 'Ongoing Support', href: '/services/#ongoing-support' },
    ],
  },
  {
    label: 'Work',
    href: '/work/',
    hasDropdown: true,
    submenu: [
      { label: 'Case Studies', href: '/work/' },
      { label: 'Clients', href: '/work/clients/' },
    ],
  },
  {
    label: 'Platforms',
    href: '/platforms/',
    hasDropdown: true,
    submenu: [
      { label: 'HubSpot', href: '/platforms/#hubspot' },
      { label: 'Shopify', href: '/platforms/#shopify' },
      { label: 'WordPress', href: '/platforms/#wordpress' },
      { label: 'Headless', href: '/platforms/#headless' },
    ],
  },
  {
    label: 'Resources',
    href: '/resources/',
    hasDropdown: true,
    submenu: [
      { label: 'Articles', href: '/resources/' },
    ],
  },
  { label: 'About', href: '/about/', hasDropdown: false },
];

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="container">
    <div class="flex items-center justify-between gap-6">
      {/* Wordmark */}
      <a href="/" class="font-[var(--font-newsreader)] text-lg font-normal text-ink no-underline" aria-label="Kelp — Home">
        Kelp
      </a>

      {/* Desktop nav with dropdown menus */}
      <nav class="hidden md:flex items-center gap-8" aria-label="Primary">
        <ul class="header-nav-list">
          {navItems.map((item, i) => (
            <li class={`header-nav-item${item.hasDropdown ? ' has-submenu' : ''}`}>
              <a
                href={item.href}
                class="nav-link"
                aria-current={currentPath === item.href ? 'page' : undefined}
                {...(item.hasDropdown
                  ? {
                      'aria-expanded': 'false',
                      'aria-controls': `submenu-${i}`,
                      'aria-haspopup': 'true',
                    }
                  : {})}
              >
                {item.label}
                {item.hasDropdown && (
                  <svg class="inline-block w-2 h-2" viewBox="0 0 10 10" fill="none" aria-hidden="true">
                    <path d="M2 4 L5 7 L8 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                )}
              </a>
              {item.hasDropdown && (
                <ul id={`submenu-${i}`} class="header-submenu">
                  {item.submenu!.map((sub) => (
                    <li>
                      <a href={sub.href} class="header-submenu-link">
                        {sub.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
        <a href="/contact/" class="nav-link" aria-current={currentPath === '/contact/' ? 'page' : undefined}>
          Contact Us
        </a>
        <a href="/contact/" class="btn">Hire Us</a>
      </nav>

      {/* Mobile hamburger */}
      <button
        type="button"
        class="md:hidden inline-flex items-center justify-center w-10 h-10 p-2 text-ink"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-mobile-menu-toggle
      >
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>

  {/* Mobile menu overlay — dialog semantics per astro-7-patterns skill §7 */}
  <div
    id="mobile-menu"
    class="hidden md:hidden fixed inset-0 bg-paper z-50 flex flex-col p-6 overflow-y-auto"
    style="top: var(--header-height);"
    data-mobile-menu
    role="dialog"
    aria-modal="true"
    aria-label="Site navigation"
  >
    <nav class="flex flex-col gap-6" aria-label="Mobile">
      {navItems.map((item) => (
        <a href={item.href} class="font-[var(--font-poppins)] text-2xl font-semibold text-ink no-underline">
          {item.label}
        </a>
      ))}
      <a href="/contact/" class="font-[var(--font-poppins)] text-2xl font-semibold text-ink no-underline">
        Contact Us
      </a>
      <a href="/contact/" class="btn mt-4 self-start">Hire Us</a>
    </nav>
  </div>
</header>

<script>
  // === Mobile menu toggle ===
  const toggle = document.querySelector<HTMLButtonElement>('[data-mobile-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');

  if (toggle && menu) {
    const closeMenu = () => {
      menu.classList.add('hidden');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Open menu');
      document.body.style.overflow = '';
      // Return focus to the toggle button so keyboard users aren't stranded
      toggle.focus();
    };

    const openMenu = () => {
      menu.classList.remove('hidden');
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', 'Close menu');
      document.body.style.overflow = 'hidden';
      // Move focus to the first focusable link inside the menu.
      // requestAnimationFrame ensures the menu is visible in the layout
      // before we try to focus it (the `hidden` class was just removed).
      requestAnimationFrame(() => {
        const firstLink = menu.querySelector<HTMLAnchorElement>('a');
        if (firstLink) firstLink.focus();
      });
    };

    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      if (isOpen) closeMenu();
      else openMenu();
    });

    // Close on Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        closeMenu();
      }
    });

    // Close on link click
    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeMenu);
    });

    // Close on Astro page transition
    document.addEventListener('astro:after-swap', closeMenu);
  }

  // === Desktop dropdown menus ===
  // Open on click (toggle), close on Escape, close on outside click,
  // close on link-click inside the submenu. Hover/focus is handled via CSS
  // (:hover, :focus-within) so we don't need JS for that.
  const initDropdowns = () => {
    document.querySelectorAll<HTMLElement>('.has-submenu').forEach((item) => {
      const trigger = item.querySelector<HTMLAnchorElement>('a[aria-expanded]');
      if (!trigger) return;
      if (trigger.dataset.dropdownInit === 'true') return;
      trigger.dataset.dropdownInit = 'true';

      const toggleOpen = (open: boolean) => {
        trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
      };

      trigger.addEventListener('click', () => {
        // Click on a nav trigger with a real href (e.g. /services/) navigates
        // by default — we do NOT preventDefault. The dropdown toggle here is
        // a progressive enhancement for users who want to peek at the submenu
        // without leaving the current page.
        const isOpen = trigger.getAttribute('aria-expanded') === 'true';
        // Close any other open submenu first
        document
          .querySelectorAll<HTMLElement>('.has-submenu a[aria-expanded="true"]')
          .forEach((other) => {
            if (other !== trigger) other.setAttribute('aria-expanded', 'false');
          });
        toggleOpen(!isOpen);
      });

      // Close on Escape
      trigger.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          toggleOpen(false);
          trigger.focus();
        }
      });
    });

    // Close any open submenu on outside click
    document.addEventListener('click', (e) => {
      const target = e.target as Node;
      document
        .querySelectorAll<HTMLElement>('.has-submenu')
        .forEach((item) => {
          if (!item.contains(target)) {
            const t = item.querySelector<HTMLAnchorElement>('a[aria-expanded]');
            if (t) t.setAttribute('aria-expanded', 'false');
          }
        });
    });
  };

  initDropdowns();
  document.addEventListener('astro:after-swap', initDropdowns);
</script>
