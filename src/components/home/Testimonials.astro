---
import Section from '../Section.astro';
import { getCollection } from 'astro:content';

const testimonials = (await getCollection('testimonials')).sort((a, b) =>
  a.id.localeCompare(b.id)
);
---

<Section bg="mist" padding="lg">
  <h2 class="font-[var(--font-poppins)] font-bold h2 mb-16 text-balance" data-reveal>
    What Our Clients Say
  </h2>

  <div class="max-w-4xl flex flex-col gap-16" data-reveal>
    {testimonials.map((t) => (
      <figure>
        {/* Custom leaf/kelp-frond-shaped quotation mark — matches original kelp.agency.
            Filled with --color-seafoam (#a1e39a), the "seaweed green" accent.
            aria-hidden because it is decorative; the blockquote carries the semantic quote. */}
        <svg
          class="testimonial-leaf"
          viewBox="0 0 90.8 67.3"
          width="56"
          height="42"
          aria-hidden="true"
          focusable="false"
        >
          <path
            d="M42.1 9.6q-12.4 5.5-16.7 10.5A16 16 0 0 0 21 30.7a8.9 8.9 0 0 0 2.6 6.5 30 30 0 0 0 6 4.7q3.5 2.1 6.1 4t2.7 3.7a17.1 17.1 0 0 1-5 12.6q-5 5-13.5 5-8.9 0-14.4-5.6T0 46a45.2 45.2 0 0 1 3.5-18.2 40 40 0 0 1 11.7-14.8Q23.4 6 37.4 0Zm48.6 0Q78.5 15.1 74 20.1a16 16 0 0 0-4.4 10.6 8.9 8.9 0 0 0 2.6 6.5 30 30 0 0 0 6 4.7q3.5 2.1 6.1 4t2.7 3.7a17.1 17.1 0 0 1-5 12.6q-5 5-13.5 5-8.9 0-14.4-5.6T48.6 46a45.2 45.2 0 0 1 3.5-18.2 40 40 0 0 1 11.7-14.8Q71.9 6 85.9 0Z"
            fill="currentColor"
          />
        </svg>
        <blockquote class="font-[var(--font-newsreader)] font-light text-ink" style="font-size: 1.4rem; line-height: 1.5;">
          {t.data.quote}
        </blockquote>
        <figcaption class="mt-8 font-[var(--font-newsreader)] text-ink" style="font-size: 1.0625rem;">
          <span class="font-semibold">{t.data.author}</span>
          <span class="text-slate"> — {t.data.role}</span>
        </figcaption>
      </figure>
    ))}
  </div>
</Section>

<style>
  .testimonial-leaf {
    color: var(--color-seafoam);
    display: block;
    margin-bottom: 1rem;
  }
</style>
