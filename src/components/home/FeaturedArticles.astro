---
import Section from '../Section.astro';

const articles = [
  {
    slug: 'manipulate-hubspot-forms-javascript',
    title: 'Manipulate HubSpot Forms with JavaScript—the Right Way',
    category: 'HubSpot',
    date: '2026-07-15',
    excerpt: 'A guide to customizing HubSpot embedded forms without breaking the form submission lifecycle.',
  },
  {
    slug: 'simple-hubdb-pagination',
    title: 'Simple HubDB Pagination',
    category: 'HubSpot',
    date: '2026-06-22',
    excerpt: 'Paginate HubDB query results with vanilla JavaScript and the HubSpot API.',
  },
  {
    slug: 'partners-vs-pirates',
    title: 'Partners VS Pirates: Navigating an Ocean of Digital Agencies',
    category: 'Agency Life',
    date: '2026-05-08',
    excerpt: "How to tell a true agency partner from a pirate in sheep's clothing.",
  },
];
---

<Section bg="paper" padding="md">
  <h3 class="font-[var(--font-poppins)] font-bold h3 mb-16" data-reveal>
    Featured Articles
  </h3>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-8" data-reveal>
    {articles.map((article) => (
      <article>
        <p class="font-[var(--font-poppins)] font-semibold uppercase tracking-wider text-kelp" style="font-size: 0.75rem; letter-spacing: 0.1em;">
          {article.category}
        </p>
        <h4 class="font-[var(--font-poppins)] font-semibold mt-3" style="font-size: 1.75rem; line-height: 1.3;">
          <a
            href={`/resources/${article.slug}/`}
            class="text-ink no-underline hover:text-kelp transition-colors"
          >
            {article.title}
          </a>
        </h4>
        <p class="font-[var(--font-newsreader)] text-slate mt-4" style="font-size: 0.9rem;">
          {new Date(article.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
        </p>
        <p class="font-[var(--font-newsreader)] mt-4" style="font-size: 1.0625rem; line-height: 1.7;">
          {article.excerpt}
        </p>
      </article>
    ))}
  </div>
</Section>
