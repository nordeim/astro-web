---
import Section from '../Section.astro';
import ArticleCover from '../ArticleCover.astro';
import { getCollection } from 'astro:content';

// Single source of truth: src/content/articles/*.md
const articles = (await getCollection('articles'))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);
---

<Section bg="paper" padding="md">
  <h3 class="font-[var(--font-poppins)] font-bold h3 mb-16" data-reveal>
    Featured Articles
  </h3>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-8" data-reveal>
    {articles.map((article) => (
      <article>
        <a
          href={`/resources/${article.id}/`}
          class="block aspect-[351/250] bg-mist overflow-hidden mb-4"
          aria-label={`Read: ${article.data.title}`}
        >
          <ArticleCover title={article.data.title} category={article.data.category} slug={article.id} />
        </a>
        <p class="font-[var(--font-poppins)] font-semibold uppercase tracking-wider text-kelp" style="font-size: 0.75rem; letter-spacing: 0.1em;">
          {article.data.category}
        </p>
        <h4 class="font-[var(--font-poppins)] font-semibold mt-3" style="font-size: 1.75rem; line-height: 1.3;">
          <a
            href={`/resources/${article.id}/`}
            class="text-ink no-underline hover:text-kelp transition-colors"
          >
            {article.data.title}
          </a>
        </h4>
        <p class="font-[var(--font-newsreader)] text-slate mt-4" style="font-size: 0.9rem;">
          {new Date(article.data.publishDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
        </p>
        <p class="font-[var(--font-newsreader)] mt-4" style="font-size: 1.0625rem; line-height: 1.7;">
          {article.data.excerpt}
        </p>
      </article>
    ))}
  </div>
</Section>
