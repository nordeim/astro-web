---
import Section from '../Section.astro';
import { getCollection } from 'astro:content';
import { SERVICE_ORDER } from '../../lib/service-order';

// Single source of truth: src/content/services/*.md
// Display order is shared with src/pages/services/index.astro via
// src/lib/service-order.ts — edit that file to reorder both surfaces.
const services = await getCollection('services');
const serviceCategories = SERVICE_ORDER
  .map((slug) => services.find((s) => s.id === slug))
  .filter((s) => s !== undefined);
---

<Section bg="paper" padding="md">
  <h2 class="font-[var(--font-poppins)] font-bold h2 mb-16 text-balance" data-reveal>
    Our Services
  </h2>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-12 lg:gap-8" data-reveal>
    {serviceCategories.map((cat) => (
      <div>
        <h3 class="font-[var(--font-poppins)] font-bold h3" style="font-size: 1.75rem; line-height: 1.2;">
          {cat!.data.title}
        </h3>
        <ul class="mt-6 space-y-3 list-none p-0">
          {cat!.data.offerings.map((service) => (
            <li>
              <a
                href={`/services/#${cat!.data.anchor}`}
                class="font-[var(--font-poppins)] font-semibold text-ink no-underline hover:text-kelp transition-colors inline-block"
                style="font-size: 0.9375rem;"
              >
                {service}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</Section>
