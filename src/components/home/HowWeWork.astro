---
import Section from '../Section.astro';

const steps = [
  {
    number: '1',
    title: 'Discovery',
    description: 'We dig into your business, audience, and goals to understand what success looks like.',
  },
  {
    number: '2',
    title: 'Planning',
    description: 'Strategy, scope, timeline, and budget — aligned before a single pixel is pushed.',
  },
  {
    number: '3',
    title: 'Production',
    description: 'Design, development, and content creation with collaborative review cycles.',
  },
  {
    number: '4',
    title: 'Market',
    description: 'Launch, promote, and measure. We help you get the word out and track results.',
  },
  {
    number: '5',
    title: 'Ongoing Support',
    description: 'Retainers, hosting, and continuous improvement. We stick around after launch.',
  },
];
---

<Section bg="ink" padding="md">
  <h2 class="font-[var(--font-poppins)] font-bold h2-display text-paper text-balance" data-reveal>
    How We Work
  </h2>

  <p class="font-[var(--font-newsreader)] text-paper mt-8 body-lg max-w-3xl" style="line-height: 1.4; opacity: 0.9;" data-reveal>
    Everything we work on follows the same 5 basic steps in order:
  </p>

  <ol class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-5 gap-8 mt-16 list-none p-0" data-reveal>
    {steps.map((step) => (
      <li>
        <h3 class="font-[var(--font-poppins)] font-semibold text-paper" style="font-size: 1.75rem; line-height: 1.3;">
          {step.number}. {step.title}
        </h3>
        <p class="font-[var(--font-newsreader)] text-paper mt-4" style="font-size: 1.0625rem; line-height: 1.7; opacity: 0.8;">
          {step.description}
        </p>
      </li>
    ))}
  </ol>
</Section>
