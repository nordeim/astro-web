---
import Section from '../Section.astro';
---

<Section bg="ink" padding="lg">
  <div class="text-center max-w-4xl mx-auto" data-reveal>
    <h3 class="font-[var(--font-poppins)] font-bold text-paper h1 text-balance">
      Ready to get started?
    </h3>
    <p class="font-[var(--font-newsreader)] font-semibold text-paper mt-8 body-lead">
      Let's get creative and start making something amazing together!
    </p>
    <a href="/contact/" class="btn btn--on-dark mt-12">
      Schedule a Meeting
    </a>
  </div>
</Section>
