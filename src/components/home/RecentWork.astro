---
import Section from '../Section.astro';
import CaseStudyCover from '../CaseStudyCover.astro';
import { getCollection } from 'astro:content';

// Single source of truth: src/content/case-studies/*.md
const caseStudies = (await getCollection('caseStudies')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
---

<Section bg="ink" padding="xl">
  <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-16">
    <h2 class="font-[var(--font-poppins)] font-bold h2 text-paper text-balance" data-reveal>
      Our Work In the real-world
    </h2>
    <a href="/work/" class="font-[var(--font-newsreader)] text-paper no-underline hover:text-kelp transition-colors inline-flex items-center gap-2" style="font-size: 1.125rem;">
      View all case studies
      <span aria-hidden="true">&rarr;</span>
    </a>
  </div>

  <div class="carousel-wrapper relative overflow-hidden" data-reveal role="region" aria-label="Recent work carousel" tabindex="0">
    <div class="carousel-track" data-carousel-track>
      {caseStudies.map((cs, i) => (
        <article
          class="carousel-slide"
          role="group"
          aria-roledescription="slide"
          aria-label={`Slide ${i + 1} of ${caseStudies.length}: ${cs.data.title}`}
        >
          <div class="grid md:grid-cols-2 gap-12 items-center">
            <div>
              <p class="font-[var(--font-poppins)] font-semibold text-kelp uppercase tracking-wider" style="font-size: 0.875rem; letter-spacing: 0.1em;">
                {cs.data.category}
              </p>
              <h3 class="font-[var(--font-poppins)] font-semibold text-paper mt-4 h3-card" style="font-size: 1.4rem;">
                {cs.data.title}
              </h3>
              <p class="font-[var(--font-newsreader)] text-paper mt-4" style="font-size: 1.125rem; line-height: 1.8; opacity: 0.85;">
                {cs.data.description}
              </p>
              <a
                href={`/work/${cs.id}/`}
                class="inline-flex items-center gap-2 mt-6 font-[var(--font-newsreader)] text-paper no-underline hover:text-kelp transition-colors"
                style="font-size: 1.125rem; border-bottom: 2px solid var(--color-kelp); padding-bottom: 4px;"
              >
                Read More About {cs.data.title}
                <span aria-hidden="true">&rarr;</span>
              </a>
            </div>
            <div class="aspect-[4/3] bg-mist" aria-hidden="false">
              <CaseStudyCover client={cs.data.client} title={cs.data.title} category={cs.data.category} slug={cs.id} />
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="flex items-center gap-2 mt-8">
      <button
        type="button"
        class="btn btn--on-dark"
        data-carousel-prev
        aria-label="Previous case study"
      >
        &larr; Prev
      </button>
      <button
        type="button"
        class="btn btn--on-dark"
        data-carousel-next
        aria-label="Next case study"
      >
        Next &rarr;
      </button>
      <span class="ml-4 font-[var(--font-newsreader)] text-paper" style="font-size: 0.9rem; opacity: 0.7;" data-carousel-counter>
        1 / {caseStudies.length}
      </span>
    </div>
  </div>
</Section>

<script>
  class KelpCarousel {
    private track: HTMLElement;
    private slides: NodeListOf<HTMLElement>;
    private prevBtn: HTMLElement | null;
    private nextBtn: HTMLElement | null;
    private counter: HTMLElement | null;
    private current = 0;

    constructor(root: HTMLElement) {
      this.track = root.querySelector('[data-carousel-track]') as HTMLElement;
      this.slides = root.querySelectorAll('.carousel-slide');
      this.prevBtn = root.querySelector('[data-carousel-prev]');
      this.nextBtn = root.querySelector('[data-carousel-next]');
      this.counter = root.querySelector('[data-carousel-counter]');

      this.prevBtn?.addEventListener('click', () => this.go(-1));
      this.nextBtn?.addEventListener('click', () => this.go(1));

      // Keyboard support — root is focusable (tabindex="0") so arrow keys
      // work when the carousel region has focus, not just when a button does.
      root.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') {
          e.preventDefault();
          this.go(-1);
        }
        if (e.key === 'ArrowRight') {
          e.preventDefault();
          this.go(1);
        }
      });
    }

    private go(delta: number) {
      const total = this.slides.length;
      this.current = (this.current + delta + total) % total;
      this.track.style.transform = `translateX(-${this.current * 100}%)`;
      if (this.counter) {
        this.counter.textContent = `${this.current + 1} / ${total}`;
      }
    }
  }

  const initCarousels = () => {
    document.querySelectorAll('.carousel-wrapper').forEach((el) => {
      const root = el as HTMLElement;
      if (!root.dataset.carouselInit) {
        root.dataset.carouselInit = 'true';
        new KelpCarousel(root);
      }
    });
  };

  initCarousels();
  document.addEventListener('astro:after-swap', initCarousels);
</script>
