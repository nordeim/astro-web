---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Section from '../../components/Section.astro';
import { getCollection } from 'astro:content';

const articles = await getCollection('articles');
const sortedArticles = articles.sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
---

<BaseLayout
  title="Kelp Resources"
  description="Articles, guides, and insights from the Kelp team. HubSpot tips, agency life, and web craft."
>
  <PageHeader
    eyebrow="Resources"
    title="Articles & guides."
    description="Practical insights from our team on HubSpot, web development, branding, and the agency life."
  />

  <Section bg="paper" padding="md">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
      {sortedArticles.map((article) => (
        <article data-reveal>
          <p class="font-[var(--font-poppins)] font-semibold uppercase tracking-wider text-kelp" style="font-size: 0.75rem; letter-spacing: 0.1em;">
            {article.data.category}
          </p>
          <h2 class="font-[var(--font-poppins)] font-semibold mt-3" style="font-size: 1.5rem; line-height: 1.3;">
            <a href={`/resources/${article.id}/`} class="text-ink no-underline hover:text-kelp transition-colors">
              {article.data.title}
            </a>
          </h2>
          <p class="font-[var(--font-newsreader)] text-slate mt-3" style="font-size: 0.9rem;">
            {new Date(article.data.publishDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          </p>
          <p class="font-[var(--font-newsreader)] mt-4" style="font-size: 1.0625rem; line-height: 1.7;">
            {article.data.excerpt}
          </p>
          <a
            href={`/resources/${article.id}/`}
            class="inline-block mt-4 font-[var(--font-newsreader)] text-ink no-underline hover:text-kelp transition-colors"
            style="font-size: 1rem; border-bottom: 2px solid var(--color-kelp); padding-bottom: 2px;"
          >
            Read article &rarr;
          </a>
        </article>
      ))}
    </div>
  </Section>
</BaseLayout>
