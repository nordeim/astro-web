---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Section from '../../components/Section.astro';

const categories = [
  {
    anchor: 'branding-design',
    title: 'Branding & Design',
    description: 'Brand identity, print design, and digital design that tells your story with clarity and craft.',
    services: ['Apparel Design', 'Company Branding', 'Digital Design', 'Print Design', 'Web Design'],
  },
  {
    anchor: 'websites',
    title: 'Websites',
    description: 'Web design, development, and ecommerce solutions that convert visitors into customers.',
    services: ['App Development', 'Web Design', 'Web Development', 'Ecommerce'],
  },
  {
    anchor: 'marketing-strategy',
    title: 'Marketing & Strategy',
    description: 'Data-driven campaigns, content, and social media that grow your audience and revenue.',
    services: ['Audience Targeting', 'Campaign Management', 'Copywriting', 'Digital Marketing', 'Social Campaigns & PPC', 'Social Media Content', 'Reporting'],
  },
  {
    anchor: 'media',
    title: 'Media',
    description: 'Motion graphics, photography, and videography that capture attention and tell stories.',
    services: ['Motion Graphics', 'Photography', 'Videography'],
  },
  {
    anchor: 'ongoing-support',
    title: 'Ongoing Support',
    description: 'Retainers, hosting, and maintenance that keep your site running smoothly after launch.',
    services: ['Ongoing Retainers', 'Web Hosting', 'Web Support & Maintenance'],
  },
];
---

<BaseLayout
  title="Services — Kelp Creative Agency"
  description="Branding & Design, Websites, Marketing & Strategy, Media, and Ongoing Support. Full-service creative agency in Central Florida."
>
  <PageHeader
    eyebrow="What We Do"
    title="Services built for craft and growth."
    description="From branding to websites to ongoing campaigns, we help Central Florida businesses grow with craft and care."
  />

  {categories.map((cat, i) => (
    <Section bg={i % 2 === 0 ? 'paper' : 'mist'} padding="md" id={cat.anchor}>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
        <div class="md:col-span-1">
          <h2 class="font-[var(--font-poppins)] font-bold h3" style="font-size: 2.5rem; line-height: 1.1;">
            {cat.title}
          </h2>
        </div>
        <div class="md:col-span-2">
          <p class="font-[var(--font-newsreader)] body-lg" style="line-height: 1.5;">
            {cat.description}
          </p>
          <ul class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-3 list-none p-0">
            {cat.services.map((service) => (
              <li class="font-[var(--font-poppins)] font-semibold text-ink" style="font-size: 1rem; padding: 12px 0; border-bottom: 1px solid rgba(13, 23, 38, 0.1);">
                {service}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </Section>
  ))}

  <Section bg="ink" padding="lg">
    <div class="text-center max-w-3xl mx-auto" data-reveal>
      <h3 class="font-[var(--font-poppins)] font-bold text-paper h2 text-balance">
        Not sure where to start?
      </h3>
      <p class="font-[var(--font-newsreader)] text-paper mt-6 body-lead" style="opacity: 0.9;">
        Schedule a free 30-minute discovery call. We'll help you figure out what you actually need.
      </p>
      <a href="/contact/" class="btn btn--on-dark mt-10">
        Schedule a Meeting
      </a>
    </div>
  </Section>
</BaseLayout>
