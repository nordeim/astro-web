---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = "Kelp Creative Agency — Central Florida's award-winning creative agency. Branding, websites, marketing, media, and ongoing support.",
  // Default OG image — lives at public/og-default.png (1200×630 recommended).
  // Maintainer must add the actual image file; the meta tag is wired so that
  // when the file is added, social shares immediately have a preview image.
  ogImage = new URL('/og-default.png', Astro.site).href,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const siteRoot = Astro.site!.href;

// === JSON-LD structured data (schema.org) ===
// Mirrors the original kelp.agency's structured-data approach. All content
// is server-controlled (no user input), so set:html is safe here per
// astro-7 anti-pattern #14 (set:html is only dangerous with untrusted input).
// JSON.stringify guarantees valid JSON escaping.
const organization = {
  '@type': 'Organization',
  '@id': `${siteRoot}#organization`,
  name: 'Kelp Creative Agency',
  url: siteRoot,
  logo: `${siteRoot}favicon.svg`,
  email: 'info@kelp.agency',
  telephone: '+1-352-325-7688',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Brooksville',
    addressRegion: 'FL',
    postalCode: '34605',
    postOfficeBoxNumber: '116',
    addressCountry: 'US',
  },
  sameAs: [
    'https://www.facebook.com/kelpagency',
    'https://www.instagram.com/kelpagency/',
    'https://x.com/kelpagency',
    'https://www.linkedin.com/company/kelpagency/',
  ],
};

const website = {
  '@type': 'WebSite',
  '@id': `${siteRoot}#website`,
  url: siteRoot,
  name: 'Kelp Creative Agency',
  publisher: { '@id': `${siteRoot}#organization` },
};

const webpage = {
  '@type': 'WebPage',
  '@id': `${canonical}#webpage`,
  url: canonical,
  name: title,
  description,
  isPartOf: { '@id': `${siteRoot}#website` },
  inLanguage: 'en',
};

// BreadcrumbList — Home → current page (skip if homepage to avoid self-referencing breadcrumb)
const isHomepage = Astro.url.pathname === '/' || Astro.url.pathname === '';
const breadcrumb = isHomepage
  ? null
  : {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: siteRoot },
        { '@type': 'ListItem', position: 2, name: title, item: canonical },
      ],
    };

const jsonLdGraph = {
  '@context': 'https://schema.org',
  '@graph': [organization, website, webpage, ...(breadcrumb ? [breadcrumb] : [])],
};

const jsonLdString = JSON.stringify(jsonLdGraph);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {/* Open Graph */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Kelp Creative Agency" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {/* Theme color — matches default page bg; dark variant for forward-compat */}
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d1726" media="(prefers-color-scheme: dark)" />

    {/* JSON-LD structured data — Organization + WebSite + WebPage + BreadcrumbList.
        set:html is safe here: content is 100% server-controlled (no user input),
        and JSON.stringify guarantees valid JSON escaping. Per astro-7 anti-pattern
        #14, set:html is only dangerous with untrusted input. */}
    <script type="application/ld+json" set:html={jsonLdString} is:inline></script>

    <ClientRouter />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    {/* Scroll reveal + header headroom script */}
    <script>
      // === Scroll reveal via IntersectionObserver ===
      // Wrapped in a function so it can be re-run on `astro:after-swap`.
      // Per astro-7-patterns §3, every DOM-querying script must re-init on
      // swap or it stops working after the first navigation.
      const initScrollReveal = () => {
        const revealEls = document.querySelectorAll('[data-reveal]');
        if (revealEls.length === 0) return;
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.15, rootMargin: '0px 0px -50px 0px' }
        );
        revealEls.forEach((el) => observer.observe(el));
      };

      // === Headroom behavior for sticky header ===
      // Idempotent init: re-queries `.site-header` on every call so that
      // the NEW header element (replaced by View Transitions) gets a fresh
      // scroll listener. The previous version captured `header` once at
      // script execution and never re-queried — after the first navigation,
      // the scroll listener kept mutating the now-detached OLD header, so
      // the NEW header never received `is-scrolled` / `headroom--pinned` /
      // `headroom--unpinned` classes (F2, round 5).
      const initHeadroom = () => {
        const header = document.querySelector<HTMLElement>('.site-header');
        if (!header) return;
        // Idempotency guard — don't double-attach the scroll listener
        if (header.dataset.headroomInit === 'true') return;
        header.dataset.headroomInit = 'true';

        let lastScroll = 0;
        const threshold = 100; // px from top before headroom kicks in

        const onScroll = () => {
          const currentScroll = window.scrollY;

          // Toggle "is-scrolled" for shadow
          if (currentScroll > 10) {
            header.classList.add('is-scrolled');
          } else {
            header.classList.remove('is-scrolled');
          }

          // Headroom: hide on scroll down, show on scroll up
          if (currentScroll > threshold) {
            if (currentScroll > lastScroll) {
              // scrolling down
              header.classList.add('headroom--unpinned');
              header.classList.remove('headroom--pinned');
            } else {
              // scrolling up
              header.classList.remove('headroom--unpinned');
              header.classList.add('headroom--pinned');
            }
          } else {
            // near top — always show
            header.classList.remove('headroom--unpinned');
            header.classList.add('headroom--pinned');
          }

          lastScroll = currentScroll;
        };

        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      };

      initScrollReveal();
      initHeadroom();

      // === Re-run on Astro page transitions ===
      // Both scroll-reveal and headroom must re-init, because View Transitions
      // replace the entire <body> (including the header element and any
      // [data-reveal] elements). Without re-init, the new elements have no
      // listeners.
      document.addEventListener('astro:after-swap', () => {
        initScrollReveal();
        initHeadroom();
      });
    </script>
  </body>
</html>
