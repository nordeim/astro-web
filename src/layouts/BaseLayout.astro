---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = "Kelp Creative Agency — Central Florida's award-winning creative agency. Branding, websites, marketing, media, and ongoing support.",
  // Default OG image — lives at public/og-default.png (1200×630 recommended).
  // Maintainer must add the actual image file; the meta tag is wired so that
  // when the file is added, social shares immediately have a preview image.
  ogImage = new URL('/og-default.png', Astro.site).href,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const siteRoot = Astro.site!.href;

// === JSON-LD structured data (schema.org) ===
// Mirrors the original kelp.agency's structured-data approach. All content
// is server-controlled (no user input), so set:html is safe here per
// astro-7 anti-pattern #14 (set:html is only dangerous with untrusted input).
// JSON.stringify guarantees valid JSON escaping.
const organization = {
  '@type': 'Organization',
  '@id': `${siteRoot}#organization`,
  name: 'Kelp Creative Agency',
  url: siteRoot,
  logo: `${siteRoot}favicon.svg`,
  email: 'info@kelp.agency',
  telephone: '+1-352-325-7688',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Brooksville',
    addressRegion: 'FL',
    postalCode: '34605',
    postOfficeBoxNumber: '116',
    addressCountry: 'US',
  },
  sameAs: [
    'https://www.facebook.com/kelpagency',
    'https://www.instagram.com/kelpagency/',
    'https://x.com/kelpagency',
    'https://www.linkedin.com/company/kelpagency/',
  ],
};

const website = {
  '@type': 'WebSite',
  '@id': `${siteRoot}#website`,
  url: siteRoot,
  name: 'Kelp Creative Agency',
  publisher: { '@id': `${siteRoot}#organization` },
};

const webpage = {
  '@type': 'WebPage',
  '@id': `${canonical}#webpage`,
  url: canonical,
  name: title,
  description,
  isPartOf: { '@id': `${siteRoot}#website` },
  inLanguage: 'en',
};

// BreadcrumbList — Home → current page (skip if homepage to avoid self-referencing breadcrumb)
const isHomepage = Astro.url.pathname === '/' || Astro.url.pathname === '';
const breadcrumb = isHomepage
  ? null
  : {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: siteRoot },
        { '@type': 'ListItem', position: 2, name: title, item: canonical },
      ],
    };

const jsonLdGraph = {
  '@context': 'https://schema.org',
  '@graph': [organization, website, webpage, ...(breadcrumb ? [breadcrumb] : [])],
};

const jsonLdString = JSON.stringify(jsonLdGraph);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {/* Open Graph */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Kelp Creative Agency" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {/* Theme color — matches default page bg; dark variant for forward-compat */}
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d1726" media="(prefers-color-scheme: dark)" />

    {/* JSON-LD structured data — Organization + WebSite + WebPage + BreadcrumbList.
        set:html is safe here: content is 100% server-controlled (no user input),
        and JSON.stringify guarantees valid JSON escaping. Per astro-7 anti-pattern
        #14, set:html is only dangerous with untrusted input. */}
    <script type="application/ld+json" set:html={jsonLdString} is:inline></script>

    <ClientRouter />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    {/* Scroll reveal + header headroom script */}
    <script>
      // === Scroll reveal via IntersectionObserver ===
      // Per astro-7-patterns §3, every DOM-querying script must re-init on
      // `astro:after-swap`. Round 5 wrapped this in a function but did NOT
      // disconnect the old observer — after N swaps, N+1 IntersectionObservers
      // existed, each holding references to detached elements (R6-4, round 6).
      // Fix: store the observer at module scope and disconnect before re-creating.
      let revealObserver: IntersectionObserver | null = null;
      const initScrollReveal = () => {
        // Disconnect the previous observer so it stops holding references
        // to the now-detached [data-reveal] elements from the previous page.
        if (revealObserver) {
          revealObserver.disconnect();
          revealObserver = null;
        }
        const revealEls = document.querySelectorAll('[data-reveal]');
        if (revealEls.length === 0) return;
        revealObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                revealObserver?.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.15, rootMargin: '0px 0px -50px 0px' }
        );
        revealEls.forEach((el) => revealObserver!.observe(el));
      };

      // === Headroom behavior for sticky header ===
      // Round 5 extracted initHeadroom() with an idempotency guard on the
      // header element. But the guard is on the header (swapped), while the
      // scroll listener is attached to window (persistent). After N swaps,
      // N+1 scroll listeners accumulated on window, each mutating a different
      // (mostly detached) header — a memory + CPU leak (R6-1, round 6).
      //
      // Fix: move the scroll listener to MODULE LEVEL (mirrors the F3 fix
      // pattern for the dropdown outside-click). The listener re-queries
      // `.site-header` inside the handler, so it always mutates the live
      // header. The `lastScroll` state and `threshold` constant move to
      // module scope. initHeadroom() is no longer needed — the module-level
      // listener + an initial onScroll() call is sufficient.
      let lastScroll = 0;
      const headroomThreshold = 100; // px from top before headroom kicks in

      const onScroll = () => {
        const header = document.querySelector<HTMLElement>('.site-header');
        if (!header) return;

        const currentScroll = window.scrollY;

        // Toggle "is-scrolled" for shadow
        if (currentScroll > 10) {
          header.classList.add('is-scrolled');
        } else {
          header.classList.remove('is-scrolled');
        }

        // Headroom: hide on scroll down, show on scroll up
        if (currentScroll > headroomThreshold) {
          if (currentScroll > lastScroll) {
            // scrolling down
            header.classList.add('headroom--unpinned');
            header.classList.remove('headroom--pinned');
          } else {
            // scrolling up
            header.classList.remove('headroom--unpinned');
            header.classList.add('headroom--pinned');
          }
        } else {
          // near top — always show
          header.classList.remove('headroom--unpinned');
          header.classList.add('headroom--pinned');
        }

        lastScroll = currentScroll;
      };

      // Attach the scroll listener ONCE at module level — window persists
      // across View Transitions, so this listener survives all navigations.
      // The handler re-queries `.site-header` on every event, so it always
      // mutates the live header element.
      window.addEventListener('scroll', onScroll, { passive: true });
      // Call once to set the initial class state.
      onScroll();

      // Re-init scroll reveal on astro:after-swap (disconnects old observer,
      // creates new one for the new [data-reveal] elements).
      // No headroom re-init needed — the module-level listener handles it
      // automatically (just call onScroll() once to reset the initial state).
      document.addEventListener('astro:after-swap', () => {
        initScrollReveal();
        onScroll();
      });

      // Initial init (on first page load).
      initScrollReveal();
    </script>
  </body>
</html>
